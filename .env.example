# Copy to .env and fill in. Never commit .env.

# Required for a live rewrite. Leave empty and use --dry-run if you have no key.
OPENAI_API_KEY=

# OpenAI-compatible base URL. Do not put the API key in the URL.
# A path that already ends in /chat/completions is used as-is.
OPENAI_BASE_URL=https://api.openai.com/v1

# Chat model id your endpoint accepts.
OPENAI_MODEL=gpt-4o-mini

# Request timeout in seconds.
OPENAI_TIMEOUT=60
